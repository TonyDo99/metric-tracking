{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Ho_Chi_Minh",
  "rebaseWhen": "behind-base-branch",
  "recreateClosed": true,
  "lockFileMaintenance": {
    "enabled": true,
    "recreateWhen": "always",
    "branchTopic": "lock-file-maintenance",
    "commitMessageAction": "yarn.lock maintainance on track",
    "prCreation": "immediate",
    "automerge": false,
    "prBodyDefinitions": {
      "Package": "{{{depNameLinked}}}{{#if newName}}{{#unless (equals depName newName)}} → {{{newNameLinked}}}{{/unless}}{{/if}}",
      "Update": "{{{updateType}}}",
      "New value": "{{{newValue}}}",
      "References": "{{{references}}}"
    },
    "prBodyColumns": ["Package", "Update", "New value", "References"]
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "vulnerabilityAlerts": {
    "enabled": true,
    "dependencyDashboardApproval": true,
    "labels": ["dependencies", "vulnerability"],
    "prCreation": "immediate",
    "automerge": false,
    "assignees": ["phat-do-tpv-clv"],
    "vulnerabilityFixStrategy": "lowest",
    "prConcurrentLimit": 5
  },
  "packageRules": [
    {
      "description": "Re-enable npm dependencies (the org preset disables all npm except NestJS/TypeScript)",
      "matchManagers": ["npm"],
      "enabled": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "enabled": false
    },
    {
      "matchDepTypes": ["resolutions"],
      "enabled": true,
      "rangeStrategy": "pin",
      "prPriority": 3
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@nestjs\\//"],
      "enabled": true,
      "allowedVersions": "11.x",
      "labels": ["renovate", "dependencies", "nestjs"],
      "groupName": "NestJS 11 dependencies",
      "prPriority": 1
    }
  ]
}
